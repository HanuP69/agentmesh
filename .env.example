# Container (docker-compose): pick nim or gemini
LLM_PROVIDER=nim
NIM_API_KEY=
GEMINI_API_KEY=

# Vector Backend Configuration
VECTOR_BACKEND=pgvector
PGVECTOR_DSN=postgresql://postgres:postgres@localhost:5432/agentmesh


# Local dev only (Ollama runs on host, not containerized):
# LLM_PROVIDER=ollama
# OLLAMA_BASE_URL=http://localhost:11434
# OLLAMA_LLM_MODEL=gemma4:e4b                       # light per-agent calls (natively multimodal)
# OLLAMA_SYNTH_MODEL=qwen2.5:7b-instruct-q4_K_M    # final answer quality
# OLLAMA_VISION_MODEL=gemma4:e4b                    # image captioning (same model as above -- no swap)
# OLLAMA_EMBED_MODEL=gemma4:e4b                     # or nomic-embed-text if pulled
# OLLAMA_KEEP_ALIVE=0                              # unload right after each call (6GB VRAM)

USE_REDIS=true

# Auth
GOOGLE_CLIENT_ID=
JWT_SECRET=change-me-in-prod
COOKIE_SECURE=false
FRONTEND_ORIGIN=http://localhost:5173
